<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Outer ring -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iv_logo"
            android:layout_width="148dp"
            android:layout_height="148dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="74dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/surface"
            app:strokeWidth="2dp">

            <!-- Inner white circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:layout_gravity="center"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="68dp"
                app:cardElevation="16dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/ic_fitlife_logo"
                    android:scaleType="fitCenter" />

            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_size_headline1" />

        <!-- Accent rule under name -->
        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/surface" />

    </LinearLayout>

</RelativeLayout>